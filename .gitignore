# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- Secrets ---
# Never a blanket *.json -- config JSON stays tracked.
.env
.streamlit/secrets.toml
*-service-account*.json
*credentials*.json
sa-key*.json

# --- macOS ---
.DS_Store

# --- Notebooks ---
.ipynb_checkpoints/

# --- Data ---
# Dataset is reproduced by the fetch script, not committed. Anchored to repo
# root (leading slash) so this doesn't also match aksha_core/data/, a real
# Python subpackage. Ignore contents (data/*) rather than the dir itself, so
# the !gitkeep negation below can actually take effect.
/data/*
!/data/.gitkeep

# --- Artifacts ---
# Explicitly NOT ignored: trained artifacts (fitted IForest + conformal
# calibration) are committed on purpose so a clone runs without training.

# --- Eval outputs ---
eval/outputs/*
!eval/outputs/.gitkeep
